# =============================================================================
# Pick ONE provider block below. The provider is inferred from the model id
# (and base URL), so switching is an env change, not a code change.
# =============================================================================

# --- Option A: Groq (FREE tier, no card) --- VERIFIED end to end ------------
# Key: https://console.groq.com/keys
# Two model families on purpose: gpt-oss for chat + tool calling (text-only),
# qwen for photos. Model names verified 2026-09 against Groq's /models
# endpoint; Groq rotates its lineup, so if a 404 names a model, list what your
# key can see and pick the current equivalents.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
TEXT_MODEL=openai/gpt-oss-20b
VISION_MODEL=qwen/qwen3.8-27b
NUTRITION_MODEL=openai/gpt-oss-20b
# Free-tier limits are per model: 8,000 tokens/minute and 200,000 tokens/day.
# The per-minute limit is the one you feel: a second call within a minute is
# a 429 and the client sleeps until the window resets (the CLI prints
# "rate limited, waiting Ns" when that happens). To remove the wait, upgrade
# to Groq Dev Tier (https://console.groq.com/settings/billing) or use Gemini.
# Daily budgets are per model too, so spreading the three roles over three
# models triples the free budget. If a 429 mentions "tokens per day", move
# the exhausted role to a model you are not already using: openai/gpt-oss-120b
# (same 0.55 to 0.85 s per call) or qwen/qwen3.6-27b (0.4 to 0.6 s, tool
# calling verified). The qwen models add a 1,000 output-tokens-per-minute cap,
# so with one of them as TEXT_MODEL keep one reply inside it:
# CALORAI_MAX_REPLY_TOKENS=400
# Reasoning models: low keeps hidden thinking tokens off the hot path. Qwen
# only knows none/default; the code maps low to none.
# MODEL_REASONING_EFFORT=low

# --- Option B: Google Gemini (FREE tier) -------------------------------------
# Key: https://aistudio.google.com/apikey
# Fully wired. Note: Google restricts some new accounts with
# "403 Your project has been denied access"; that is account-side.
# GOOGLE_API_KEY=
# TEXT_MODEL=gemini-3.5-flash-lite
# VISION_MODEL=gemini-3.5-flash
# NUTRITION_MODEL=gemini-3.5-flash-lite

# --- Option C: Anthropic (paid) ----------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# TEXT_MODEL=claude-haiku-4-5
# VISION_MODEL=claude-sonnet-5
# NUTRITION_MODEL=claude-haiku-4-5

# --- Option D: OpenAI (paid) -------------------------------------------------
# OPENAI_API_KEY=sk-...
# TEXT_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o
# NUTRITION_MODEL=gpt-4o-mini

# --- Option E: any other OpenAI-compatible host ------------------------------
# GitHub Models, OpenRouter, Together, or a fully local Ollama. Set the base
# URL and use that host's model names.
# OPENAI_API_KEY=<that host's key; any value for local Ollama>
# OPENAI_BASE_URL=http://localhost:11434/v1
# TEXT_MODEL=llama3.1
# VISION_MODEL=llava

# --- Nutrition data ----------------------------------------------------------
# Optional. USDA FoodData Central fills in foods the seed table does not know,
# before falling back to an LLM estimate. Off when empty.
# Free personal key (1,000 req/hour): https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY also works but is capped at 10 req/hour - enough to see it work.
USDA_API_KEY=

# --- Storage -----------------------------------------------------------------
CALORAI_DB=data/calorai.db
# Conversation threads (so a pending clarification survives a restart).
CALORAI_CHECKPOINT_DB=data/checkpoints.db
CALORAI_LATENCY_LOG=data/latency.jsonl

# --- Behaviour ---------------------------------------------------------------
# Timezone used to decide which calendar day a meal belongs to.
CALORAI_TZ_OFFSET_HOURS=5.5
# Max memories injected into the system prompt per turn (context-bloat guard).
CALORAI_MAX_MEMORIES=8
# Recent-history token budget the model sees per call. The full thread stays
# in the checkpointer; facts live in SQLite, so this can be small. One call is
# roughly 2,000 tokens of system prompt + tool schemas on top of this budget.
# Groq's free tier allows 8,000 tokens/minute per model, so 800 keeps a
# tool-call-plus-reply turn inside one minute; 2000 makes the second call
# hit a 429 and silently wait 10 to 60 s. Raise it on a paid tier.
CALORAI_MAX_HISTORY_TOKENS=800

# Cap on one conversation reply (max_tokens). Replies are a sentence or two,
# so 400 is generous; it matters on tiers that also cap output tokens per
# minute (Groq's qwen models: 1,000), where a request asking for more than
# the cap is rejected outright rather than queued.
CALORAI_MAX_REPLY_TOKENS=400

# Set to 1 to run the deterministic scripted test-double model instead of a real
# LLM. Used by the eval suite so plumbing can be verified without API keys.
# CALORAI_MOCK=0

# --- Optional: LangSmith tracing ---------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=calorai-agent
