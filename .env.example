# --- Credentials -------------------------------------------------------------
# Only ANTHROPIC_API_KEY is required for the default configuration.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you point VISION_MODEL (or TEXT_MODEL) at an OpenAI model.
# OPENAI_API_KEY=sk-...

# --- Model routing -----------------------------------------------------------
# Two separate models on purpose: a fast/cheap one for conversation + tool
# calling, a stronger one for food recognition from photos.
# The provider is inferred from the model id prefix (claude-* -> Anthropic,
# gpt-* -> OpenAI), so either of these can be swapped without code changes.
TEXT_MODEL=claude-haiku-4-5
VISION_MODEL=claude-sonnet-5

# Model used to estimate nutrition for foods that miss both the seed table and
# the SQLite cache. Kept small on purpose - it is on the critical path.
NUTRITION_MODEL=claude-haiku-4-5

# --- Storage -----------------------------------------------------------------
CALORAI_DB=data/calorai.db
CALORAI_LATENCY_LOG=data/latency.jsonl

# --- Behaviour ---------------------------------------------------------------
# Timezone used to decide which calendar day a meal belongs to.
CALORAI_TZ_OFFSET_HOURS=5.5
# Max memories injected into the system prompt per turn (context-bloat guard).
CALORAI_MAX_MEMORIES=8

# Set to 1 to run the deterministic scripted test-double model instead of a real
# LLM. Used by the eval suite so plumbing can be verified without API keys.
# CALORAI_MOCK=0

# --- Optional: LangSmith tracing ---------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=calorai-agent
