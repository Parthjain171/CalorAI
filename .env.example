# =============================================================================
# Pick ONE provider block below. The provider is inferred from the model id, so
# switching is an env change, not a code change.
# =============================================================================

# --- Option A: Google Gemini (FREE tier) -------------------------------------
# Free key: https://aistudio.google.com/apikey
# Two different models on purpose: a fast one for conversation + tool calling,
# a stronger one for recognising food in photos.
GOOGLE_API_KEY=
TEXT_MODEL=gemini-2.0-flash-lite
VISION_MODEL=gemini-2.0-flash
NUTRITION_MODEL=gemini-2.0-flash-lite

# --- Option B: Anthropic (paid, the original configuration) ------------------
# ANTHROPIC_API_KEY=sk-ant-...
# TEXT_MODEL=claude-haiku-4-5
# VISION_MODEL=claude-sonnet-5
# NUTRITION_MODEL=claude-haiku-4-5

# --- Option C: OpenAI (paid) -------------------------------------------------
# OPENAI_API_KEY=sk-...
# TEXT_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o
# NUTRITION_MODEL=gpt-4o-mini

# --- Option D: any OpenAI-compatible host (Groq / GitHub Models / OpenRouter /
#     Ollama). Set the base URL and use that host's model names.
# OPENAI_API_KEY=<that host's key; any value for local Ollama>
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# TEXT_MODEL=llama-3.3-70b-versatile
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# Ollama (fully local, no key needed):
# OPENAI_BASE_URL=http://localhost:11434/v1
# TEXT_MODEL=llama3.1
# VISION_MODEL=llava

# --- Storage -----------------------------------------------------------------
CALORAI_DB=data/calorai.db
CALORAI_LATENCY_LOG=data/latency.jsonl

# --- Behaviour ---------------------------------------------------------------
# Timezone used to decide which calendar day a meal belongs to.
CALORAI_TZ_OFFSET_HOURS=5.5
# Max memories injected into the system prompt per turn (context-bloat guard).
CALORAI_MAX_MEMORIES=8

# Set to 1 to run the deterministic scripted test-double model instead of a real
# LLM. Used by the eval suite so plumbing can be verified without API keys.
# CALORAI_MOCK=0

# --- Optional: LangSmith tracing ---------------------------------------------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=calorai-agent
